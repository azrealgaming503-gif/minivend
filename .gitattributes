# Default: let Git auto-detect text vs binary, and normalize text to LF in the repo.
* text=auto eol=lf

# Files that MUST keep LF endings on disk too, because they are executed on
# Linux (the Raspberry Pi) and CRLF would break them.
*.sh             text eol=lf
*.service        text eol=lf
*.timer          text eol=lf
*.conf           text eol=lf
*.rules          text eol=lf
sudoers-*        text eol=lf
Dockerfile       text eol=lf
.env.example     text eol=lf

# JS / web sources also LF-only so kiosk and dev environments agree.
*.js             text eol=lf
*.mjs            text eol=lf
*.cjs            text eol=lf
*.json           text eol=lf
*.html           text eol=lf
*.css            text eol=lf
*.md             text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf

# Binary assets — never touch.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.webp           binary
*.mp4            binary
*.webm           binary
*.mov            binary
*.bin            binary
*.pdf            binary
