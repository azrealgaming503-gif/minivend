# PlatformIO build artifacts
.pio/
.pioenvs/
.piolibdeps/

# VS Code workspace cache (keep settings.json if you want shared editor config)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
**/.env
!**/.env.example
!**/.env.example.txt

# Pi-app runtime state (created on the device, not source-controlled)
pi-app/assets/state.json
pi-app/assets/idle/*
pi-app/assets/alerts/*
!pi-app/assets/idle/.gitkeep
!pi-app/assets/alerts/.gitkeep
pi-app/.last-good-commit
pi-app/.update-state.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.bak
*~

# Editor noise
.idea/
*.iml
