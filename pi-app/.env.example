# Copy to .env on the Pi and edit to taste.

# HTTP/WS port the kiosk UI loads from (http://localhost:PORT).
PORT=3000

# ESP32 motor controller serial port.
# Linux examples:  /dev/ttyUSB0   /dev/ttyACM0
# Set to AUTO to pick the first detected USB-serial adapter at boot.
MOTOR_PORT=AUTO
MOTOR_BAUD=115200

# Folder roots (absolute paths). Defaults are dev-friendly; the
# installer rewrites ASSETS_DIR to /var/lib/minivend/assets so OTA
# `git reset --hard` cannot wipe uploaded animations.
ASSETS_DIR=./assets
GAMES_DIR=./ui/games

# Donation pipeline.
# StreamElements webhook HMAC secret (set this in the SE dashboard).
SE_WEBHOOK_SECRET=
# Ko-fi verification token (set this in the Ko-fi webhook settings).
KOFI_VERIFICATION_TOKEN=

# Dispense policy.
# Default motor and run time used when a donation arrives without
# explicit tier mapping. Tweak per mechanism.
DEFAULT_DISPENSE_MOTOR=1
DEFAULT_DISPENSE_DIR=1
DEFAULT_DISPENSE_SPEED=1200
DEFAULT_DISPENSE_MAX_MS=3000

# StreamElements OAuth (live donation feed, no webhook needed).
# Leave SE_RELAY_URL blank to disable OAuth pairing — the kiosk will
# fall back to "paste JWT" in the settings UI. To enable QR pairing,
# deploy the worker in /oauth-relay and put its URL here, e.g.:
#   SE_RELAY_URL=https://minivend-pair.example.workers.dev
# SE_CLIENT_ID is just shown for transparency in the pairing UI; the
# relay owns the actual OAuth client_id/client_secret.
SE_RELAY_URL=
SE_CLIENT_ID=
SE_REDIRECT_URI=
# Tokens live here (chmod 600). Leave default unless you want them
# stored elsewhere (e.g. an encrypted volume).
SE_TOKENS_FILE=../se-tokens.json

# OTA updates.
# When the minivend-updater.timer fires (once a day by default), it
# either just `git fetch`s (so the UI shows "update available") or
# applies the update straight away. Set this to "true" for fully
# unattended fleet updates; leave unset for click-to-apply.
AUTO_APPLY_UPDATES=
